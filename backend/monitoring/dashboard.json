   "properties": {
    "title": "Bedrock · 입력/출력 토큰 (비용 추정용)",
    "region": "ap-northeast-2",
    "view": "timeSeries",
    "stacked": false,
    "period": 300,
    "metrics": [
     [
      {
       "expression": "SEARCH('{AWS/Bedrock,ModelId} MetricName=\"InputTokenCount\"', 'Sum', 300)",
       "id": "e2",
       "label": "입력"
      }
     ],
     [
      {
       "expression": "SEARCH('{AWS/Bedrock,ModelId} MetricName=\"OutputTokenCount\"', 'Sum', 300)",
       "id": "e3",
       "label": "출력"
      }
     ]
    ]
   }
  },
  {
   "type": "metric",
   "x": 16,
   "y": 14,
   "width": 8,
   "height": 6,
   "properties": {
    "title": "Bedrock · 지연 / 오류",
    "region": "ap-northeast-2",
    "view": "timeSeries",
    "stacked": false,
    "period": 300,
    "metrics": [
     [
      {
       "expression": "SEARCH('{AWS/Bedrock,ModelId} MetricName=\"InvocationLatency\"', 'Average', 300)",
       "id": "e4",
       "label": "지연(ms)"
      }
     ],
     [
      {
       "expression": "SEARCH('{AWS/Bedrock,ModelId} MetricName=\"InvocationClientErrors\" OR MetricName=\"InvocationServerErrors\" OR MetricName=\"InvocationThrottles\"', 'Sum', 300)",
       "id": "e5",
       "label": "오류/스로틀"
      }
     ]
    ]
   }
  },
  {
   "type": "log",
   "x": 0,
   "y": 20,
   "width": 12,
   "height": 6,
   "properties": {
    "title": "Bedrock 호출 결과 (성공 / 실패 / 근거 없음)",
    "region": "ap-northeast-2",
    "view": "table",
    "query": "SOURCE '/aws/lambda/react-learn-api' | filter event = 'bedrock_call' | stats count(*) as calls, sum(outcome='success' and grounded=1) as grounded, sum(outcome='success' and grounded=0) as no_answer, sum(outcome='failure') as failures, avg(latencyMs) as avg_ms by bin(1h) | sort bin(1h) desc"
   }
  },
  {
   "type": "log",
   "x": 12,
   "y": 20,
   "width": 12,
   "height": 6,
   "properties": {
    "title": "Bedrock 호출 실패 목록",
    "region": "ap-northeast-2",
    "view": "table",
    "query": "SOURCE '/aws/lambda/react-learn-api' | filter event = 'bedrock_call' and outcome = 'failure' | fields @timestamp, errorName, errorMessage, latencyMs | sort @timestamp desc | limit 50"
   }
  },
  {
   "type": "log",
   "x": 0,
   "y": 26,
   "width": 12,
   "height": 6,
   "properties": {
    "title": "API Gateway 직접 접근 차단 (CloudFront 우회 시도)",
    "region": "ap-northeast-2",
    "view": "table",
    "query": "SOURCE '/aws/lambda/react-learn-api' | filter event = 'direct_access_blocked' | fields @timestamp, sourceIp | sort @timestamp desc | limit 50"
   }
  },
  {
   "type": "log",
   "x": 12,
   "y": 26,
   "width": 12,
   "height": 6,
   "properties": {
    "title": "Lambda 최근 로그 (오류·타임아웃 포함)",
    "region": "ap-northeast-2",
    "view": "table",
    "query": "SOURCE '/aws/lambda/react-learn-api' | fields @timestamp, @message | filter @message like /ERROR|Task timed out|bedrock_call|REPORT/ | sort @timestamp desc | limit 100"
   }
  }
 ]
