{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRagDocuments",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::react-learn-rag-docs-917246555749",
      "Condition": { "StringEquals": { "aws:ResourceAccount": "917246555749" } }
    },
    {
      "Sid": "ReadRagDocumentObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::react-learn-rag-docs-917246555749/*",
      "Condition": { "StringEquals": { "aws:ResourceAccount": "917246555749" } }
    },
    {
      "Sid": "InvokeTitanEmbeddings",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:ap-northeast-2::foundation-model/amazon.titan-embed-text-v2:0"
    },
    {
      "Sid": "ReadWriteVectorIndex",
      "Effect": "Allow",
      "Action": [
        "s3vectors:PutVectors", "s3vectors:GetVectors", "s3vectors:DeleteVectors",
        "s3vectors:QueryVectors", "s3vectors:GetIndex"
      ],
      "Resource": "arn:aws:s3vectors:ap-northeast-2:917246555749:bucket/react-learn-vectors/index/react-learn-react-docs"
    }
  ]
}
